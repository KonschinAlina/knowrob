{
  "logging": {
    "console-sink": { "level": "debug" },
    "file-sink": { "level": "debug" }
  },
  "semantic-web": {
    "prefixes": [
      { "alias": "lpn", "uri":  "http://knowrob.org/kb/lpn" },
      { "alias": "suturo", "uri": "http://www.ease-crc.org/ont/SUTURO.owl#" }
    ]
  },
  "data-sources": [
    {
      "path": "tests/owl/suturo.owl",
      "format": "turtle"
    }
  ],
  "data-backends": [
    {
      "name": "pl",
      "type": "Prolog:rdf_db"
    }
  ],
  "reasoner": [
    {
      "name": "pl",
      "type": "Prolog",
      "data-backend": "pl",
      "imports": [
        {
          "path": "tests/prolog/has_property.pl",
          "format": "prolog"
        }
      ]
    }
  ]
}
